rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidTimestamp(ts) {
      return ts is timestamp && ts <= request.time;
    }

    function isBoundedStringList(lst, maxLen) {
      return lst is list && lst.size() <= maxLen && (lst.size() == 0 || lst[0] is string);
    }

    function isValidUserProfile(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80 &&
             data.about is string && data.about.size() <= 200 &&
             data.phoneNumber is string && data.phoneNumber.size() <= 30 &&
             data.countryCode is string && data.countryCode.size() <= 10 &&
             data.email is string && data.email.size() <= 120 &&
             (!('photoBase64' in data) || (data.photoBase64 is string && data.photoBase64.size() <= 500000)) &&
             (!('avatarColorHex' in data) || (data.avatarColorHex is string && data.avatarColorHex.size() <= 16)) &&
             data.themeMode in ['system', 'light', 'dark'] &&
             data.notificationsEnabled is bool &&
             data.readReceiptsEnabled is bool &&
             data.lastSeenVisibility in ['everyone', 'contacts', 'nobody'] &&
             data.statusPrivacy in ['everyone', 'contacts', 'contacts_except', 'only_share_with', 'private'] &&
             (!('statusExcludedIds' in data) || isBoundedStringList(data.statusExcludedIds, 100)) &&
             (!('statusAllowedIds' in data) || isBoundedStringList(data.statusAllowedIds, 100)) &&
             data.appLanguage is string && data.appLanguage.size() >= 1 && data.appLanguage.size() <= 40 &&
             data.securityLockEnabled is bool &&
             data.isOnline is bool &&
             data.lastSeenText is string && data.lastSeenText.size() <= 60 &&
             (!('fcmToken' in data) || (data.fcmToken is string && data.fcmToken.size() <= 512));
    }

    function isValidPublicProfile(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80 &&
             data.about is string && data.about.size() <= 200 &&
             data.avatarColorHex is string && data.avatarColorHex.size() >= 1 && data.avatarColorHex.size() <= 16 &&
             (!('photoBase64' in data) || (data.photoBase64 is string && data.photoBase64.size() <= 500000)) &&
             data.discoverable is bool &&
             data.isOnline is bool &&
             data.lastSeenText is string && data.lastSeenText.size() <= 60;
    }

    function isValidChat(data) {
      return data.title is string && data.title.size() >= 1 && data.title.size() <= 100 &&
             data.isGroup is bool &&
             data.avatarColorHex is string && data.avatarColorHex.size() >= 1 && data.avatarColorHex.size() <= 16 &&
             isBoundedStringList(data.participantIds, 50) && data.participantIds.size() >= 1 &&
             data.createdBy is string && data.createdBy.size() >= 1 && data.createdBy.size() <= 128 &&
             data.lastMessageText is string && data.lastMessageText.size() <= 500 &&
             data.lastMessageType in ['text', 'image', 'voice', 'call'] &&
             data.lastMessageSenderId is string && data.lastMessageSenderId.size() <= 128 &&
             data.lastMessageStatus in ['sent', 'delivered', 'read'] &&
             isBoundedStringList(data.pinnedBy, 50) &&
             isBoundedStringList(data.mutedBy, 50) &&
             data.unreadCount is int && data.unreadCount >= 0 && data.unreadCount <= 9999;
    }

    function isValidMessage(data) {
      return data.chatId is string && isValidId(data.chatId) &&
             data.senderId is string && data.senderId.size() >= 1 && data.senderId.size() <= 128 &&
             data.senderName is string && data.senderName.size() >= 1 && data.senderName.size() <= 80 &&
             isBoundedStringList(data.participantIds, 50) && data.participantIds.size() >= 1 &&
             data.text is string && data.text.size() <= 4000 &&
             data.mediaType in ['text', 'image', 'voice'] &&
             data.mediaBase64 is string && data.mediaBase64.size() <= 600000 &&
             data.voiceDurationSec is int && data.voiceDurationSec >= 0 && data.voiceDurationSec <= 600 &&
             data.status in ['sent', 'delivered', 'read'] &&
             isBoundedStringList(data.readBy, 50) &&
             data.replyToText is string && data.replyToText.size() <= 500;
    }

    function isValidStatusUpdate(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.userName is string && data.userName.size() >= 1 && data.userName.size() <= 80 &&
             data.avatarColorHex is string && data.avatarColorHex.size() >= 1 && data.avatarColorHex.size() <= 16 &&
             data.mediaType in ['text', 'photo', 'video'] &&
             data.caption is string && data.caption.size() <= 700 &&
             data.mediaBase64 is string && data.mediaBase64.size() <= 600000 &&
             (!('mediaUrl' in data) || (data.mediaUrl is string && data.mediaUrl.size() <= 2048)) &&
             (!('storagePath' in data) || (data.storagePath is string && data.storagePath.size() <= 512)) &&
             data.backgroundColorHex is string && data.backgroundColorHex.size() >= 1 && data.backgroundColorHex.size() <= 16 &&
             (!('fontStyle' in data) || data.fontStyle in ['sans', 'serif', 'bold', 'mono', 'cursive']) &&
             data.privacy in ['everyone', 'contacts', 'contacts_except', 'only_share_with', 'private'] &&
             isBoundedStringList(data.visibleTo, 100) &&
             isBoundedStringList(data.viewedBy, 100) &&
             (!('expiresAt' in data) || (data.expiresAt is timestamp && data.expiresAt <= request.time + duration.value(26, 'h')));
    }

    function isValidCommunity(data) {
      return data.name is string && data.name.size() >= 1 && data.name.size() <= 100 &&
             data.description is string && data.description.size() <= 500 &&
             data.avatarColorHex is string && data.avatarColorHex.size() >= 1 && data.avatarColorHex.size() <= 16 &&
             data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 &&
             isBoundedStringList(data.memberIds, 50) && data.memberIds.size() >= 1 &&
             isBoundedStringList(data.linkedChatIds, 20) &&
             data.announcementText is string && data.announcementText.size() <= 1000;
    }

    function isTerminalCallStatus(status) {
      return status in ['ended', 'rejected', 'cancelled', 'missed', 'failed'];
    }

    function isValidCallSession(data) {
      return data.callerId is string && data.callerId.size() >= 1 && data.callerId.size() <= 128 &&
             data.callerName is string && data.callerName.size() >= 1 && data.callerName.size() <= 80 &&
             (!('callerPhotoBase64' in data) || (data.callerPhotoBase64 is string && data.callerPhotoBase64.size() <= 500000)) &&
             (!('callerAvatarColorHex' in data) || (data.callerAvatarColorHex is string && data.callerAvatarColorHex.size() <= 16)) &&
             data.receiverId is string && data.receiverId.size() >= 1 && data.receiverId.size() <= 128 &&
             data.receiverId != data.callerId &&
             data.receiverName is string && data.receiverName.size() >= 1 && data.receiverName.size() <= 80 &&
             isBoundedStringList(data.participantIds, 10) && data.participantIds.size() == 2 &&
             data.participantIds.hasAll([data.callerId, data.receiverId]) &&
             data.callType in ['voice', 'video'] &&
             data.direction in ['outgoing', 'incoming', 'missed'] &&
             data.status in ['calling', 'ringing', 'accepted', 'connected', 'rejected', 'cancelled', 'ended', 'missed', 'failed'] &&
             data.connectionState in ['new', 'checking', 'connected', 'reconnecting', 'disconnected', 'failed', 'closed'] &&
             data.durationSec is int && data.durationSec >= 0 && data.durationSec <= 86400 &&
             data.sdpOffer is string && data.sdpOffer.size() <= 32000 &&
             data.sdpAnswer is string && data.sdpAnswer.size() <= 32000 &&
             (!('failureReason' in data) || (data.failureReason is string && data.failureReason.size() <= 300)) &&
             (!('startedAt' in data) || isValidTimestamp(data.startedAt)) &&
             (!('endedAt' in data) || isValidTimestamp(data.endedAt));
    }

    function isValidCallTransition(uid) {
      let changed = incoming().diff(existing()).affectedKeys();
      return (
        // Caller updates
        (uid == existing().callerId && (
          // Caller sends SDP offer or updates connectionState without changing status
          (changed.hasOnly(['sdpOffer', 'connectionState', 'updatedAt']) &&
           incoming().status == existing().status) ||
          // Caller marks accepted -> connected upon ICE connection
          (changed.hasOnly(['status', 'connectionState', 'updatedAt']) &&
           existing().status in ['accepted', 'connected'] &&
           incoming().status == 'connected') ||
          // Caller cancels or marks missed before receiver answers
          (changed.hasOnly(['status', 'connectionState', 'direction', 'durationSec', 'endedAt', 'updatedAt']) &&
           existing().status in ['calling', 'ringing'] &&
           incoming().status in ['cancelled', 'missed']) ||
          // Caller terminates active/failing call
          (changed.hasOnly(['status', 'connectionState', 'durationSec', 'failureReason', 'endedAt', 'updatedAt']) &&
           incoming().status in ['ended', 'failed'])
        )) ||
        // Receiver updates
        (uid == existing().receiverId && (
          // Receiver marks ringing
          (changed.hasOnly(['status', 'updatedAt']) &&
           existing().status == 'calling' &&
           incoming().status == 'ringing') ||
          // Receiver accepts and/or sends SDP answer
          (changed.hasOnly(['sdpAnswer', 'status', 'connectionState', 'startedAt', 'updatedAt']) &&
           existing().status in ['calling', 'ringing', 'accepted'] &&
           incoming().status in ['accepted', 'connected']) ||
          // Receiver updates connectionState or marks connected
          (changed.hasOnly(['status', 'connectionState', 'updatedAt']) &&
           existing().status in ['accepted', 'connected'] &&
           incoming().status in ['accepted', 'connected']) ||
          // Receiver rejects incoming ringing call
          (changed.hasOnly(['status', 'connectionState', 'durationSec', 'endedAt', 'updatedAt']) &&
           existing().status in ['calling', 'ringing'] &&
           incoming().status == 'rejected') ||
          // Receiver terminates connected call or reports failure
          (changed.hasOnly(['status', 'connectionState', 'durationSec', 'failureReason', 'endedAt', 'updatedAt']) &&
           (incoming().status == 'failed' ||
            (existing().status in ['accepted', 'connected'] && incoming().status == 'ended')))
        ))
      );
    }

    function isValidIceCandidate(data) {
      return data.callId is string && isValidId(data.callId) &&
             data.senderId is string && data.senderId.size() >= 1 && data.senderId.size() <= 128 &&
             isBoundedStringList(data.participantIds, 10) && data.participantIds.size() == 2 &&
             data.sdpMid is string && data.sdpMid.size() <= 64 &&
             data.sdpMLineIndex is int && data.sdpMLineIndex >= 0 && data.sdpMLineIndex <= 32 &&
             data.candidate is string && data.candidate.size() >= 1 && data.candidate.size() <= 2048;
    }

    function isValidPhoneDirectoryEntry(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80 &&
             data.avatarColorHex is string && data.avatarColorHex.size() >= 1 && data.avatarColorHex.size() <= 16;
    }

    // 1. Private User Profile & Settings (PII isolated strictly to owner)
    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && isOwner(userId);
      allow list: if isSignedIn() && request.auth.uid == userId;

      allow create: if isSignedIn() &&
                       isValidId(userId) &&
                       isOwner(userId) &&
                       incoming().userId == request.auth.uid &&
                       incoming().keys().hasAll([
                         'userId', 'displayName', 'about', 'phoneNumber', 'countryCode', 'email',
                         'themeMode', 'notificationsEnabled', 'readReceiptsEnabled', 'lastSeenVisibility',
                         'statusPrivacy', 'appLanguage', 'securityLockEnabled', 'isOnline', 'lastSeenText',
                         'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'userId', 'displayName', 'about', 'phoneNumber', 'countryCode', 'email',
                         'photoBase64', 'avatarColorHex', 'themeMode', 'notificationsEnabled',
                         'readReceiptsEnabled', 'lastSeenVisibility', 'statusPrivacy',
                         'statusExcludedIds', 'statusAllowedIds', 'appLanguage',
                         'securityLockEnabled', 'isOnline', 'lastSeenText', 'fcmToken',
                         'createdAt', 'updatedAt'
                       ]) &&
                       isValidUserProfile(incoming()) &&
                       isValidTimestamp(incoming().createdAt) &&
                       isValidTimestamp(incoming().updatedAt);

      allow update: if isSignedIn() &&
                       isValidId(userId) &&
                       isOwner(userId) &&
                       isValidUserProfile(incoming()) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       isValidTimestamp(incoming().updatedAt) &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'displayName', 'about', 'phoneNumber', 'countryCode', 'photoBase64',
                         'avatarColorHex', 'themeMode', 'notificationsEnabled', 'readReceiptsEnabled',
                         'lastSeenVisibility', 'statusPrivacy', 'statusExcludedIds', 'statusAllowedIds',
                         'appLanguage', 'securityLockEnabled', 'isOnline', 'lastSeenText',
                         'fcmToken', 'updatedAt'
                       ]);

      allow delete: if isSignedIn() && isValidId(userId) && isOwner(userId);
    }

    // 2. Public Profiles (Non-PII contact cards)
    match /public_profiles/{userId} {
      allow get: if isSignedIn() && isValidId(userId);
      allow list: if isSignedIn() && resource.data.discoverable == true;

      allow create: if isSignedIn() &&
                       isValidId(userId) &&
                       isOwner(userId) &&
                       incoming().userId == request.auth.uid &&
                       incoming().keys().hasAll([
                         'userId', 'displayName', 'about', 'avatarColorHex', 'discoverable',
                         'isOnline', 'lastSeenText', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'userId', 'displayName', 'about', 'avatarColorHex', 'photoBase64',
                         'discoverable', 'isOnline', 'lastSeenText', 'createdAt', 'updatedAt'
                       ]) &&
                       isValidPublicProfile(incoming()) &&
                       isValidTimestamp(incoming().createdAt) &&
                       isValidTimestamp(incoming().updatedAt);

      allow update: if isSignedIn() &&
                       isValidId(userId) &&
                       isOwner(userId) &&
                       isValidPublicProfile(incoming()) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       isValidTimestamp(incoming().updatedAt) &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'displayName', 'about', 'avatarColorHex', 'photoBase64', 'discoverable',
                         'isOnline', 'lastSeenText', 'updatedAt'
                       ]);

      allow delete: if isSignedIn() && isValidId(userId) && isOwner(userId);
    }

    // 3. Chats & Messages
    match /chats/{chatId} {
      allow get: if isSignedIn() && isValidId(chatId) && request.auth.uid in resource.data.participantIds;
      allow list: if isSignedIn() && request.auth.uid in resource.data.participantIds;

      allow create: if isSignedIn() &&
                       isValidId(chatId) &&
                       incoming().createdBy == request.auth.uid &&
                       request.auth.uid in incoming().participantIds &&
                       incoming().keys().hasAll([
                         'title', 'isGroup', 'avatarColorHex', 'participantIds', 'createdBy',
                         'lastMessageText', 'lastMessageType', 'lastMessageSenderId',
                         'lastMessageStatus', 'pinnedBy', 'mutedBy', 'unreadCount',
                         'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'title', 'isGroup', 'avatarColorHex', 'participantIds', 'createdBy',
                         'lastMessageText', 'lastMessageType', 'lastMessageSenderId',
                         'lastMessageStatus', 'pinnedBy', 'mutedBy', 'unreadCount',
                         'createdAt', 'updatedAt'
                       ]) &&
                       isValidChat(incoming()) &&
                       isValidTimestamp(incoming().createdAt) &&
                       isValidTimestamp(incoming().updatedAt);

      allow update: if isSignedIn() &&
                       isValidId(chatId) &&
                       request.auth.uid in existing().participantIds &&
                       isValidChat(incoming()) &&
                       incoming().createdBy == existing().createdBy &&
                       incoming().createdAt == existing().createdAt &&
                       isValidTimestamp(incoming().updatedAt) && (
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'lastMessageText', 'lastMessageType', 'lastMessageSenderId',
                           'lastMessageStatus', 'unreadCount', 'updatedAt'
                         ]) ||
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'pinnedBy', 'mutedBy', 'unreadCount', 'updatedAt'
                         ]) ||
                         (existing().createdBy == request.auth.uid &&
                          incoming().diff(existing()).affectedKeys().hasOnly([
                            'title', 'avatarColorHex', 'participantIds', 'updatedAt'
                          ]))
                       );

      allow delete: if isSignedIn() && isValidId(chatId) && existing().createdBy == request.auth.uid;

      match /messages/{messageId} {
        allow get: if isSignedIn() && isValidId(chatId) && isValidId(messageId) &&
                      request.auth.uid in resource.data.participantIds;
        allow list: if isSignedIn() && request.auth.uid in resource.data.participantIds;

        allow create: if isSignedIn() &&
                         isValidId(chatId) &&
                         isValidId(messageId) &&
                         incoming().senderId == request.auth.uid &&
                         request.auth.uid in incoming().participantIds &&
                         incoming().chatId == chatId &&
                         incoming().keys().hasAll([
                           'chatId', 'senderId', 'senderName', 'participantIds', 'text',
                           'mediaType', 'mediaBase64', 'voiceDurationSec', 'status',
                           'readBy', 'replyToText', 'createdAt', 'updatedAt'
                         ]) &&
                         incoming().keys().hasOnly([
                           'chatId', 'senderId', 'senderName', 'participantIds', 'text',
                           'mediaType', 'mediaBase64', 'voiceDurationSec', 'status',
                           'readBy', 'replyToText', 'createdAt', 'updatedAt'
                         ]) &&
                         isValidMessage(incoming()) &&
                         isValidTimestamp(incoming().createdAt) &&
                         isValidTimestamp(incoming().updatedAt) &&
                         exists(/databases/$(database)/documents/chats/$(chatId));

        allow update: if isSignedIn() &&
                         isValidId(chatId) &&
                         isValidId(messageId) &&
                         request.auth.uid in existing().participantIds &&
                         isValidMessage(incoming()) &&
                         incoming().senderId == existing().senderId &&
                         incoming().chatId == existing().chatId &&
                         incoming().createdAt == existing().createdAt &&
                         isValidTimestamp(incoming().updatedAt) &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['status', 'readBy', 'updatedAt']);

        allow delete: if isSignedIn() && isValidId(chatId) && isValidId(messageId) &&
                         existing().senderId == request.auth.uid;
      }
    }

    // 4. Status Updates (24h expiring text, photo, video with Storage URL & privacy scoping)
    match /statuses/{statusId} {
      allow get: if isSignedIn() && isValidId(statusId) && (
        resource.data.userId == request.auth.uid ||
        request.auth.uid in resource.data.visibleTo ||
        resource.data.privacy == 'everyone'
      );
      allow list: if isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        request.auth.uid in resource.data.visibleTo ||
        resource.data.privacy == 'everyone'
      );

      allow create: if isSignedIn() &&
                       isValidId(statusId) &&
                       incoming().userId == request.auth.uid &&
                       incoming().keys().hasAll([
                         'userId', 'userName', 'avatarColorHex', 'mediaType', 'caption',
                         'mediaBase64', 'backgroundColorHex', 'privacy', 'visibleTo',
                         'viewedBy', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'userId', 'userName', 'avatarColorHex', 'mediaType', 'caption',
                         'mediaBase64', 'mediaUrl', 'storagePath', 'backgroundColorHex',
                         'fontStyle', 'privacy', 'visibleTo', 'viewedBy',
                         'expiresAt', 'createdAt', 'updatedAt'
                       ]) &&
                       isValidStatusUpdate(incoming()) &&
                       isValidTimestamp(incoming().createdAt) &&
                       isValidTimestamp(incoming().updatedAt);

      allow update: if isSignedIn() &&
                       isValidId(statusId) &&
                       isValidStatusUpdate(incoming()) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       isValidTimestamp(incoming().updatedAt) && (
                         ((existing().userId == request.auth.uid ||
                           request.auth.uid in existing().visibleTo ||
                           existing().privacy == 'everyone') &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['viewedBy', 'updatedAt'])) ||
                         (existing().userId == request.auth.uid &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['caption', 'privacy', 'visibleTo', 'updatedAt']))
                       );

      allow delete: if isSignedIn() && isValidId(statusId) && existing().userId == request.auth.uid;
    }

    // 5. Communities
    match /communities/{communityId} {
      allow get: if isSignedIn() && isValidId(communityId) && (
        request.auth.uid in resource.data.memberIds ||
        resource.data.ownerId == request.auth.uid
      );
      allow list: if isSignedIn() && request.auth.uid in resource.data.memberIds;

      allow create: if isSignedIn() &&
                       isValidId(communityId) &&
                       incoming().ownerId == request.auth.uid &&
                       request.auth.uid in incoming().memberIds &&
                       incoming().keys().hasAll([
                         'name', 'description', 'avatarColorHex', 'ownerId', 'memberIds',
                         'linkedChatIds', 'announcementText', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'name', 'description', 'avatarColorHex', 'ownerId', 'memberIds',
                         'linkedChatIds', 'announcementText', 'createdAt', 'updatedAt'
                       ]) &&
                       isValidCommunity(incoming()) &&
                       isValidTimestamp(incoming().createdAt) &&
                       isValidTimestamp(incoming().updatedAt);

      allow update: if isSignedIn() &&
                       isValidId(communityId) &&
                       existing().ownerId == request.auth.uid &&
                       isValidCommunity(incoming()) &&
                       incoming().ownerId == existing().ownerId &&
                       incoming().createdAt == existing().createdAt &&
                       isValidTimestamp(incoming().updatedAt) &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'name', 'description', 'memberIds', 'linkedChatIds', 'announcementText', 'updatedAt'
                       ]);

      allow delete: if isSignedIn() && isValidId(communityId) && existing().ownerId == request.auth.uid;
    }

    // 6. WebRTC Call Sessions & Signaling
    match /call_sessions/{callId} {
      allow get: if isSignedIn() && isValidId(callId) && request.auth.uid in resource.data.participantIds;
      allow list: if isSignedIn() && request.auth.uid in resource.data.participantIds;

      allow create: if isSignedIn() &&
                       isValidId(callId) &&
                       incoming().callerId == request.auth.uid &&
                       request.auth.uid in incoming().participantIds &&
                       incoming().status == 'calling' &&
                       incoming().connectionState == 'new' &&
                       incoming().keys().hasAll([
                         'callerId', 'callerName', 'receiverId', 'receiverName', 'participantIds',
                         'callType', 'direction', 'status', 'connectionState', 'durationSec',
                         'sdpOffer', 'sdpAnswer', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'callerId', 'callerName', 'callerPhotoBase64', 'callerAvatarColorHex',
                         'receiverId', 'receiverName', 'participantIds',
                         'callType', 'direction', 'status', 'connectionState', 'durationSec',
                         'sdpOffer', 'sdpAnswer', 'failureReason', 'startedAt', 'endedAt',
                         'createdAt', 'updatedAt'
                       ]) &&
                       isValidCallSession(incoming()) &&
                       isValidTimestamp(incoming().createdAt) &&
                       isValidTimestamp(incoming().updatedAt);

      allow update: if isSignedIn() &&
                       isValidId(callId) &&
                       request.auth.uid in existing().participantIds &&
                       isValidCallSession(incoming()) &&
                       incoming().callerId == existing().callerId &&
                       incoming().receiverId == existing().receiverId &&
                       incoming().participantIds == existing().participantIds &&
                       incoming().callType == existing().callType &&
                       incoming().createdAt == existing().createdAt &&
                       (!('startedAt' in existing()) || incoming().startedAt == existing().startedAt) &&
                       isValidTimestamp(incoming().updatedAt) &&
                       !isTerminalCallStatus(existing().status) &&
                       isValidCallTransition(request.auth.uid);

      allow delete: if isSignedIn() && isValidId(callId) && request.auth.uid == existing().callerId;

      match /candidates/{candidateId} {
        allow get: if isSignedIn() && isValidId(callId) && isValidId(candidateId) &&
                      request.auth.uid in resource.data.participantIds;
        allow list: if isSignedIn() && isValidId(callId) &&
                       request.auth.uid in resource.data.participantIds;

        allow create: if isSignedIn() &&
                         isValidId(callId) &&
                         isValidId(candidateId) &&
                         incoming().senderId == request.auth.uid &&
                         request.auth.uid in incoming().participantIds &&
                         incoming().callId == callId &&
                         incoming().keys().hasAll([
                           'callId', 'senderId', 'participantIds', 'sdpMid',
                           'sdpMLineIndex', 'candidate', 'createdAt'
                         ]) &&
                         incoming().keys().hasOnly([
                           'callId', 'senderId', 'participantIds', 'sdpMid',
                           'sdpMLineIndex', 'candidate', 'createdAt'
                         ]) &&
                         isValidIceCandidate(incoming()) &&
                         isValidTimestamp(incoming().createdAt) &&
                         exists(/databases/$(database)/documents/call_sessions/$(callId)) &&
                         request.auth.uid in get(/databases/$(database)/documents/call_sessions/$(callId)).data.participantIds &&
                         !isTerminalCallStatus(get(/databases/$(database)/documents/call_sessions/$(callId)).data.status) &&
                         incoming().participantIds == get(/databases/$(database)/documents/call_sessions/$(callId)).data.participantIds;

        allow update: if false;

        allow delete: if isSignedIn() && isValidId(callId) && isValidId(candidateId) &&
                         request.auth.uid in existing().participantIds;
      }
    }

    // 7. Phone Directory (Exact SHA-256 hash lookup only; list disabled to prevent scraping)
    match /phone_directory/{phoneHash} {
      allow get: if isSignedIn() && isValidId(phoneHash);
      allow list: if false;

      allow create: if isSignedIn() &&
                       isValidId(phoneHash) &&
                       incoming().userId == request.auth.uid &&
                       incoming().keys().hasAll(['userId', 'displayName', 'avatarColorHex', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['userId', 'displayName', 'avatarColorHex', 'createdAt', 'updatedAt']) &&
                       isValidPhoneDirectoryEntry(incoming()) &&
                       isValidTimestamp(incoming().createdAt) &&
                       isValidTimestamp(incoming().updatedAt);

      allow update: if isSignedIn() &&
                       isValidId(phoneHash) &&
                       existing().userId == request.auth.uid &&
                       isValidPhoneDirectoryEntry(incoming()) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       isValidTimestamp(incoming().updatedAt) &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'avatarColorHex', 'updatedAt']);

      allow delete: if isSignedIn() && isValidId(phoneHash) && existing().userId == request.auth.uid;
    }
  }
}
