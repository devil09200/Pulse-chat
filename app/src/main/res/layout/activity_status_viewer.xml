<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/viewer_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/status_viewer_bg">

    <!-- Media Layers -->
    <FrameLayout
        android:id="@+id/viewer_media_stage"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/status_viewer_bg"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Text Status Stage -->
        <FrameLayout
            android:id="@+id/viewer_text_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingHorizontal="28dp"
            android:paddingVertical="96dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tv_viewer_text_story"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:lineSpacingMultiplier="1.15"
                android:textColor="@color/white"
                android:textSize="28sp" />
        </FrameLayout>

        <!-- Photo Status Image -->
        <ImageView
            android:id="@+id/iv_viewer_photo"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="Status photo"
            android:scaleType="fitCenter"
            android:visibility="gone" />

        <!-- Video Status Player -->
        <androidx.media3.ui.PlayerView
            android:id="@+id/pv_viewer_video"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            app:resize_mode="fit"
            app:use_controller="false" />

        <ProgressBar
            android:id="@+id/pb_viewer_loading"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_gravity="center"
            android:indeterminateTint="@color/status_primary_green"
            android:visibility="gone" />
    </FrameLayout>

    <!-- Touch / Tap / Swipe Navigation Overlay -->
    <View
        android:id="@+id/viewer_gesture_overlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintBottom_toTopOf="@id/viewer_bottom_container"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/viewer_top_container" />

    <!-- Top Progress Bars & Header Bar -->
    <LinearLayout
        android:id="@+id/viewer_top_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_status_top_scrim"
        android:orientation="vertical"
        android:paddingHorizontal="12dp"
        android:paddingTop="10dp"
        android:paddingBottom="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Segmented Progress Indicator Row -->
        <LinearLayout
            android:id="@+id/viewer_progress_segments"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingVertical="4dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.example.ui.status.views.StatusRingAvatarView
                android:id="@+id/viewer_avatar"
                android:layout_width="42dp"
                android:layout_height="42dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_viewer_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_viewer_timestamp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#CCFFFFFF"
                    android:textSize="12sp" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/btn_viewer_mute"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Toggle mute"
                android:padding="12dp"
                android:src="@drawable/ic_status_volume_up"
                android:visibility="gone"
                app:tint="@color/white" />

            <ImageButton
                android:id="@+id/btn_viewer_pause"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Pause or resume status"
                android:padding="12dp"
                android:src="@drawable/ic_status_pause"
                app:tint="@color/white" />

            <ImageButton
                android:id="@+id/btn_viewer_delete"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Delete status"
                android:padding="12dp"
                android:src="@drawable/ic_status_delete"
                android:visibility="gone"
                app:tint="@color/white" />

            <ImageButton
                android:id="@+id/btn_viewer_close"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Close viewer"
                android:padding="12dp"
                android:src="@drawable/ic_status_close"
                app:tint="@color/white" />
        </LinearLayout>
    </LinearLayout>

    <!-- Bottom Caption, Reactions, Private Reply & Owner View Count -->
    <LinearLayout
        android:id="@+id/viewer_bottom_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_status_bottom_scrim"
        android:orientation="vertical"
        android:paddingHorizontal="14dp"
        android:paddingTop="18dp"
        android:paddingBottom="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:id="@+id/tv_viewer_caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:gravity="center"
            android:maxLines="4"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:visibility="gone" />

        <!-- Emoji Quick Reactions (Friend Status) -->
        <HorizontalScrollView
            android:id="@+id/viewer_reactions_scroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/viewer_reactions_row"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <!-- Private Reply Field (Friend Status) -->
        <LinearLayout
            android:id="@+id/viewer_reply_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/et_viewer_reply"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_status_reply_input"
                android:hint="@string/status_reply_hint"
                android:imeOptions="actionSend"
                android:inputType="textCapSentences"
                android:maxLength="500"
                android:maxLines="3"
                android:minHeight="48dp"
                android:paddingHorizontal="16dp"
                android:paddingVertical="10dp"
                android:textColor="@color/white"
                android:textColorHint="#B3FFFFFF"
                android:textSize="15sp" />

            <Space
                android:layout_width="8dp"
                android:layout_height="wrap_content" />

            <ImageButton
                android:id="@+id/btn_viewer_send_reply"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_status_plus_badge"
                android:contentDescription="Send private reply"
                android:padding="12dp"
                android:src="@drawable/ic_status_send"
                app:tint="@color/white" />
        </LinearLayout>

        <!-- Owner View Count Pill (My Status) -->
        <LinearLayout
            android:id="@+id/viewer_owner_views_bar"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/bg_status_pill_dark"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingHorizontal="18dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_status_visibility"
                app:tint="@color/white" />

            <TextView
                android:id="@+id/tv_viewer_view_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
