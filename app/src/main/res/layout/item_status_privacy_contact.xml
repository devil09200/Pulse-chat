<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:minHeight="62dp"
    android:orientation="horizontal"
    android:paddingHorizontal="16dp"
    android:paddingVertical="8dp">

    <com.example.ui.status.views.StatusRingAvatarView
        android:id="@+id/privacy_contact_avatar"
        android:layout_width="44dp"
        android:layout_height="44dp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_privacy_contact_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/status_primary_text"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_privacy_contact_about"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/status_secondary_text"
            android:textSize="13sp" />
    </LinearLayout>

    <CheckBox
        android:id="@+id/cb_privacy_contact"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:buttonTint="@color/status_primary_green"
        android:clickable="false"
        android:focusable="false" />
</LinearLayout>
