<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/callRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/call_background"
    tools:context=".calling.CallActivity">

    <!-- Full-screen remote video stage (visible on video calls) -->
    <FrameLayout
        android:id="@+id/videoStageContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/call_dark_canvas"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <org.webrtc.SurfaceViewRenderer
            android:id="@+id/remoteVideoView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Subtle top gradient scrim for readability over remote video -->
        <View
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:background="@drawable/bg_status_top_scrim" />

        <!-- Subtle bottom gradient scrim for controls -->
        <View
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:layout_gravity="bottom"
            android:background="@drawable/bg_status_bottom_scrim" />
    </FrameLayout>

    <!-- Voice-call WhatsApp-inspired top header band -->
    <View
        android:id="@+id/voiceHeaderBackdrop"
        android:layout_width="0dp"
        android:layout_height="220dp"
        android:background="@color/call_header_green"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Top bar: Peer info & call type badge -->
    <LinearLayout
        android:id="@+id/callTopBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/callEncryptedBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_call_badge"
            android:drawablePadding="6dp"
            android:gravity="center"
            android:paddingHorizontal="12dp"
            android:paddingVertical="4dp"
            android:text="@string/call_encrypted_badge"
            android:textColor="@color/white"
            android:textSize="11sp"
            app:drawableStartCompat="@drawable/ic_status_lock" />

        <TextView
            android:id="@+id/callPeerName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/white"
            android:textSize="24sp"
            android:textStyle="bold"
            tools:text="Elena Rostova" />

        <TextView
            android:id="@+id/callStatusText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/call_status_calling"
            android:textColor="#E6FFFFFF"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/callTimerText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/call_primary_green"
            android:textSize="16sp"
            android:textStyle="bold"
            android:visibility="gone"
            tools:text="01:24" />
    </LinearLayout>

    <!-- Voice-call center circular avatar container -->
    <FrameLayout
        android:id="@+id/voiceAvatarContainer"
        android:layout_width="176dp"
        android:layout_height="176dp"
        android:background="@drawable/bg_call_avatar_ring"
        android:padding="10dp"
        app:layout_constraintBottom_toTopOf="@id/callErrorCard"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/callTopBar">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/voicePeerAvatarImage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/app_name"
            android:scaleType="centerCrop"
            android:visibility="gone"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full" />

        <TextView
            android:id="@+id/voicePeerAvatarInitials"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_status_plus_badge"
            android:backgroundTint="@color/call_secondary_green"
            android:gravity="center"
            android:textColor="@color/white"
            android:textSize="46sp"
            android:textStyle="bold"
            tools:text="ER" />
    </FrameLayout>

    <!-- Floating local camera preview (video calls only) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/localVideoContainer"
        android:layout_width="112dp"
        android:layout_height="164dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="20dp"
        android:visibility="gone"
        app:cardBackgroundColor="#FF1E2930"
        app:cardCornerRadius="16dp"
        app:cardElevation="8dp"
        app:layout_constraintBottom_toTopOf="@id/callControlsContainer"
        app:layout_constraintEnd_toEndOf="parent"
        app:strokeColor="#99FFFFFF"
        app:strokeWidth="1.5dp">

        <org.webrtc.SurfaceViewRenderer
            android:id="@+id/localVideoView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <TextView
            android:id="@+id/localCameraOffLabel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#CC111B21"
            android:gravity="center"
            android:padding="8dp"
            android:text="Camera off"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:visibility="gone" />
    </com.google.android.material.card.MaterialCardView>

    <!-- Clear NAT / STUN / Permission error banner -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/callErrorCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginBottom="16dp"
        android:visibility="gone"
        app:cardBackgroundColor="@color/call_error_bg"
        app:cardCornerRadius="14dp"
        app:cardElevation="2dp"
        app:layout_constraintBottom_toTopOf="@id/callControlsContainer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:strokeColor="@color/call_end_red"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:id="@+id/callErrorText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/call_main_text"
                android:textSize="13sp"
                tools:text="@string/call_stun_nat_error" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="end"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/callErrorRetryButton"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:text="@string/call_retry"
                    android:textColor="@color/call_secondary_green" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/callErrorDismissButton"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:text="@string/call_close"
                    android:textColor="@color/call_end_red" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Bottom control bar -->
    <LinearLayout
        android:id="@+id/callControlsContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_call_controls_sheet"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingTop="18dp"
        android:paddingBottom="22dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- Speaker Toggle -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSpeaker"
                style="@style/Widget.Material3.Button.IconButton.Filled"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:contentDescription="@string/call_speaker"
                app:backgroundTint="@color/call_secondary_green"
                app:icon="@drawable/ic_call_speaker_off"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconTint="@color/white" />

            <TextView
                android:id="@+id/labelSpeaker"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/call_speaker"
                android:textColor="@color/white"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Camera Toggle (Video calls) -->
        <LinearLayout
            android:id="@+id/groupToggleCamera"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnToggleCamera"
                style="@style/Widget.Material3.Button.IconButton.Filled"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:contentDescription="@string/call_camera_toggle"
                app:backgroundTint="@color/call_secondary_green"
                app:icon="@drawable/ic_call_video_on"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconTint="@color/white" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/call_camera_toggle"
                android:textColor="@color/white"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Switch Front/Back Camera (Video calls) -->
        <LinearLayout
            android:id="@+id/groupSwitchCamera"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSwitchCamera"
                style="@style/Widget.Material3.Button.IconButton.Filled"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:contentDescription="@string/call_switch_camera"
                app:backgroundTint="@color/call_secondary_green"
                app:icon="@drawable/ic_call_switch_camera"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconTint="@color/white" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/call_switch_camera"
                android:textColor="@color/white"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Microphone Mute Toggle -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnMute"
                style="@style/Widget.Material3.Button.IconButton.Filled"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:contentDescription="@string/call_mute"
                app:backgroundTint="@color/call_secondary_green"
                app:icon="@drawable/ic_call_mic_on"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconTint="@color/white" />

            <TextView
                android:id="@+id/labelMute"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/call_mute"
                android:textColor="@color/white"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- End Call Button (#EA4335) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEndCall"
                style="@style/Widget.Material3.Button.IconButton.Filled"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:contentDescription="@string/call_end"
                app:backgroundTint="@color/call_end_red"
                app:icon="@drawable/ic_call_end"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconSize="28dp"
                app:iconTint="@color/white" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/call_end"
                android:textColor="@color/white"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
