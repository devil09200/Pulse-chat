<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/incomingCallRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/call_header_green"
    tools:context=".calling.IncomingCallActivity">

    <TextView
        android:id="@+id/incomingEncryptedBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:background="@drawable/bg_call_badge"
        android:drawablePadding="6dp"
        android:gravity="center"
        android:paddingHorizontal="14dp"
        android:paddingVertical="5dp"
        android:text="@string/call_encrypted_badge"
        android:textColor="@color/white"
        android:textSize="12sp"
        app:drawableStartCompat="@drawable/ic_status_lock"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/incomingCallTypeLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:text="@string/incoming_voice_call_label"
        android:textColor="@color/call_primary_green"
        android:textSize="15sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/incomingEncryptedBadge" />

    <TextView
        android:id="@+id/incomingCallerName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="8dp"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="2"
        android:textColor="@color/white"
        android:textSize="28sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/incomingCallTypeLabel"
        tools:text="Marcus Vance" />

    <FrameLayout
        android:id="@+id/incomingAvatarFrame"
        android:layout_width="184dp"
        android:layout_height="184dp"
        android:background="@drawable/bg_call_avatar_ring"
        android:padding="12dp"
        app:layout_constraintBottom_toTopOf="@id/incomingActionRow"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/incomingCallerName">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/incomingCallerAvatarImage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/app_name"
            android:scaleType="centerCrop"
            android:visibility="gone"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full" />

        <TextView
            android:id="@+id/incomingCallerInitials"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_status_plus_badge"
            android:backgroundTint="@color/call_secondary_green"
            android:gravity="center"
            android:textColor="@color/white"
            android:textSize="50sp"
            android:textStyle="bold"
            tools:text="MV" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/incomingActionRow"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="40dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="36dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRejectIncomingCall"
                style="@style/Widget.Material3.Button.IconButton.Filled"
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:contentDescription="@string/call_reject"
                app:backgroundTint="@color/call_end_red"
                app:icon="@drawable/ic_call_end"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconSize="30dp"
                app:iconTint="@color/white" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/call_reject"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAcceptIncomingCall"
                style="@style/Widget.Material3.Button.IconButton.Filled"
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:contentDescription="@string/call_accept"
                app:backgroundTint="@color/call_primary_green"
                app:icon="@drawable/ic_call_accept"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconSize="30dp"
                app:iconTint="@color/white" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/call_accept"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
