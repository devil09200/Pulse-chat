<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/privacy_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/status_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Dark Green Top Header -->
        <LinearLayout
            android:id="@+id/privacy_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/status_primary_dark_green"
            android:elevation="4dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="4dp"
                android:paddingEnd="16dp">

                <ImageButton
                    android:id="@+id/btn_privacy_back"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Back"
                    android:padding="12dp"
                    android:src="@drawable/ic_status_back"
                    app:tint="@color/white" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:text="@string/status_privacy_title"
                    android:textColor="@color/white"
                    android:textSize="20sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="96dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="16dp"
                    android:paddingTop="16dp"
                    android:paddingBottom="8dp"
                    android:text="@string/status_privacy_subtitle"
                    android:textColor="@color/status_secondary_green"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <RadioGroup
                    android:id="@+id/rg_status_privacy"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <RadioButton
                        android:id="@+id/rb_privacy_contacts"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:buttonTint="@color/status_primary_green"
                        android:minHeight="56dp"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="10dp"
                        android:text="@string/status_privacy_my_contacts"
                        android:textColor="@color/status_primary_text"
                        android:textSize="16sp" />

                    <RadioButton
                        android:id="@+id/rb_privacy_except"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:buttonTint="@color/status_primary_green"
                        android:minHeight="56dp"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="10dp"
                        android:text="@string/status_privacy_except"
                        android:textColor="@color/status_primary_text"
                        android:textSize="16sp" />

                    <RadioButton
                        android:id="@+id/rb_privacy_only_with"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:buttonTint="@color/status_primary_green"
                        android:minHeight="56dp"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="10dp"
                        android:text="@string/status_privacy_only_with"
                        android:textColor="@color/status_primary_text"
                        android:textSize="16sp" />

                    <RadioButton
                        android:id="@+id/rb_privacy_everyone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:buttonTint="@color/status_primary_green"
                        android:minHeight="56dp"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="10dp"
                        android:text="@string/status_privacy_everyone"
                        android:textColor="@color/status_primary_text"
                        android:textSize="16sp" />
                </RadioGroup>

                <TextView
                    android:id="@+id/tv_privacy_description"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="16dp"
                    android:paddingBottom="12dp"
                    android:text="@string/status_privacy_footer"
                    android:textColor="@color/status_secondary_text"
                    android:textSize="13sp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/status_divider" />

                <!-- Contact Picker Section (Shown for My Contacts Except / Only Share With) -->
                <LinearLayout
                    android:id="@+id/privacy_contacts_section"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingTop="12dp"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/tv_privacy_picker_header"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="16dp"
                        android:text="Select contacts"
                        android:textColor="@color/status_primary_text"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/et_privacy_contact_search"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginHorizontal="16dp"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="8dp"
                        android:background="@drawable/bg_status_chip_green"
                        android:hint="Search Vice Messenger contacts..."
                        android:inputType="text"
                        android:maxLines="1"
                        android:paddingHorizontal="14dp"
                        android:textColor="@color/status_primary_text"
                        android:textColorHint="@color/status_secondary_text"
                        android:textSize="14sp" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rv_privacy_contacts"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false" />

                    <TextView
                        android:id="@+id/tv_privacy_contacts_empty"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:padding="24dp"
                        android:text="No registered contacts found yet."
                        android:textColor="@color/status_secondary_text"
                        android:textSize="14sp"
                        android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </LinearLayout>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab_privacy_save"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="18dp"
        android:contentDescription="Save status privacy"
        app:backgroundTint="@color/status_primary_green"
        app:srcCompat="@drawable/ic_status_send"
        app:tint="@color/white" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
