        <item name="colorPrimary">@color/status_primary_dark_green</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/status_primary_green</item>
        <item name="android:windowBackground">@color/status_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
