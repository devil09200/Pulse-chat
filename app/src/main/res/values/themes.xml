<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.MyApplication" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/status_primary_dark_green</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/status_primary_green</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorSurface">@color/status_background</item>
        <item name="colorOnSurface">@color/status_primary_text</item>
